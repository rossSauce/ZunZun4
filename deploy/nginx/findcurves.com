# /etc/nginx/sites-available/findcurves.com  (installed by deploy/install.sh)
server {
	listen 80;
	listen [::]:80;
	server_name findcurves.com www.findcurves.com;
	root /var/www/html/findcurves.com;

	location / {
		proxy_pass http://localhost:8000;
		proxy_set_header Host $http_host;
		proxy_redirect off;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		client_max_body_size 20m;
	}

	# Graphs, result pages and PDFs generated by the site, plus temp/static_images.
	# Django only serves these itself under "manage.py runserver" (DEBUG), so nginx serves them.
	# Only the listed file types are served: temp/ also holds exception logs (*.log) and
	# pid_*.trace files, which must not be public.
	location /temp/ {
		root /var/www/html/zunzunsite3;
		location ~* \.(png|svg|gif|jpe?g|ico|pdf|html|js|css)$ {
		}
		return 404;
	}

	# never serve dot-files or dot-directories such as .git (the CommonProblems alias contains one)
	location ~ /\. {
		deny all;
	}

	location /CommonProblems/ {
		alias /var/www/html/commonproblems/;
	}

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/findcurves.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/findcurves.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
